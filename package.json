{
  "name": "mobile_wdio",
  "type": "module",
  "devDependencies": {
    "@wdio/allure-reporter": "^9.21.0",
    "@wdio/appium-service": "^9.20.1",
    "@wdio/cli": "^9.20.1",
    "@wdio/local-runner": "^9.20.1",
    "@wdio/mocha-framework": "^9.20.1",
    "@wdio/spec-reporter": "^9.20.0",
    "allure-commandline": "^2.34.1",
    "appium-uiautomator2-driver": "^6.3.0",
    "cross-env": "^10.1.0",
    "wdio-ctrf-json-reporter": "^0.0.17"
  },
  "scripts": {
    "wdio": "wdio run ./wdio.conf.ts",
    "wdio:android": "wdio run ./wdio.conf.ts",
    "wdio:ios": "cross-env PLATFORM=ios wdio run ./wdio.conf.ts",
    "wdio:fresh": "node scripts/install-apk.mjs && wdio run ./wdio.conf.ts",
    "install-apk": "node scripts/install-apk.mjs",
    "report:ctrf": "cat ctrf/ctrf-report.json",
    "report:allure": "allure generate allure-results --clean && allure open"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
